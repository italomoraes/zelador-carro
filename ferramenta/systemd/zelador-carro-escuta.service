[Unit]
Description=zelador-carro escuta: grava, só lendo, a orientação da navegação BMW (SOME/IP)
RequiresMountsFor=/var/opt
After=local-fs.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
# root: a política do SOME/IP da central só libera esses serviços para o root.
# Sem rede: a internet da central (mgu-uplink) recusa o root.
Environment=VSOMEIP_CONFIGURATION=/etc/vsomeip
ExecStart=/var/opt/zelador-carro/current/zelador-escuta --pasta /var/opt/zelador-carro/dados/escuta --dono 59473 --limite-mb 100 --gira-kb 1024 --gira-min 10
Restart=always
RestartSec=30
TimeoutStopSec=10
NoNewPrivileges=yes
Nice=19
IOSchedulingClass=idle
CPUShares=64
CPUQuota=10%
MemoryLimit=64M
TasksMax=32
LimitCORE=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
